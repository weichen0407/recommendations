  "properties": {
    "briefs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          },
          "entities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "minItems": 0,
            "maxItems": 10,
            "uniqueItems": true
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "minItems": 1,
            "maxItems": 12,
            "uniqueItems": true
          },
          "audience": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "rd_engineer",
                  "researcher",
                  "innovation_product_strategy",
                  "in_house_ip_legal",
                  "patent_ip_services",
                  "other"
                ]
              },
              "industry": {
                "type": "string",
                "enum": [
                  "medical_devices",
                  "materials",
                  "automotive",
                  "electronics_manufacturing",
                  "engineering",
                  "biotech",
                  "food_farming_production",
                  "energy",
                  "chemical",
                  "construction",
                  "other"
                ]
              },
              "jtbd": {
                "type": "string",
                "enum": [
                  "technical_solutions",
                  "existing_technologies",
                  "product_ideas",
                  "technical_feasibility",
                  "patent_ip_risk",
                  "new_research_fields",
                  "research_methods",
                  "research_trends",
                  "research_ideas",
                  "patents_literature",
                  "technology_competitors",
                  "innovation_opportunities",
                  "rd_directions",
                  "patent_landscapes",
                  "product_ip_risks",
                  "prior_art",
                  "fto_design_risks",
                  "draft_review_patents",
                  "office_actions",
                  "fto_searches",
