            },
            "required": [
              "rationale",
              "industry_status"
            ],
            "additionalProperties": false
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            },
            "minItems": 0,
            "maxItems": 8,
            "uniqueItems": true
          }
        },
        "required": [
          "title",
          "description",
          "entities",
          "keywords",
          "audience",
          "tags",
          "classification",
          "assumptions"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true
    }
  },
  "required": [
    "briefs"
  ],
  "additionalProperties": false,
  "x-schema-version": "2.0.0",
  "x-taxonomy-version": "2.2.0",
  "x-catalog-file": "content_brief_catalog.json"
}
