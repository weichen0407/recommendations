                  "product_design",
                  "process_engineering",
                  "system_integration",
                  "reliability_engineering",
                  "invention_development",
                  "applied_research",
                  "scientific_contribution",
                  "research_methodology",
                  "technology_scouting",
                  "product_strategy",
                  "competitive_intelligence",
                  "ip_portfolio_management",
                  "patent_risk_review",
                  "commercial_legal_review",
                  "patent_evidence_analysis",
                  "patent_prosecution",
