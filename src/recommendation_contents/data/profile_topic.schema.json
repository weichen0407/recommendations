                  "technology_landscape",
                  "product_ideation",
                  "feasibility_assessment",
                  "validation_planning",
                  "research_field_exploration",
                  "research_gap_identification",
                  "research_method_search",
                  "research_method_comparison",
                  "research_ideation",
                  "evidence_search",
                  "evidence_synthesis",
                  "research_trend_tracking",
                  "technology_trend_tracking",
                  "competitor_tracking",
                  "innovation_opportunity_identification",
